#!/bin/bash
###
# Description: Run ansible-playbook locally against a synced repository during xCAT node provisioning.
# Source: https://github.com/ncsa/xcat-tools
#
# Usage:
#   ansible_playbook [OPTIONS]
#
# Key Workflow:
# 1. Checks sentinel file to prevent duplicate execution.
# 2. Resolves Python & Ansible dependencies (creates an ephemeral venv if needed).
# 3. Decodes xCAT group tags, site table options, or CLI flags to determine inventory,
#    playbook, branch, limit pattern, and vault credentials.
# 4. Fetches Ansible Galaxy roles/collections if requirements.yml is present.
# 5. Executes ansible-playbook locally and logs output to /root/xcat_ansible_playbook_output.txt.
# 6. Cleans up temporary venv, vault password, and base git repository upon successful execution.
###

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${SCRIPT_DIR}/ansible_common" ]; then
    source "${SCRIPT_DIR}/ansible_common"
elif [ -f "/xcatpost/ansible_common" ]; then
    source "/xcatpost/ansible_common"
elif [ -f "/xcatpost/custom/ansible_common" ]; then
    source "/xcatpost/custom/ansible_common"
else
    echo "ERROR: Cannot locate ansible_common helper file." >&2
    exit 99
fi

# -----------------------------------------------------------------------------
# Configuration Defaults & Environment Settings
# -----------------------------------------------------------------------------

# 0. PIP PACKAGE VERSION BOUNDARIES
MIN_ANSIBLE_CORE_VER="${MIN_ANSIBLE_CORE_VER:-2.15.0}"
MAX_ANSIBLE_CORE_VER="${MAX_ANSIBLE_CORE_VER:-2.17.0}"

MIN_ANSIBLE_PKG_VER="${MIN_ANSIBLE_PKG_VER:-8.0.0}"
MAX_ANSIBLE_PKG_VER="${MAX_ANSIBLE_PKG_VER:-10.0.0}"

# 1. ENABLE_SENTINEL / SENTINEL_FILE:
ENABLE_SENTINEL=1
SENTINEL_FILE="/var/log/xcat_ansible_playbook.done"

# 2. IGNORE_PLAYBOOK_EXIT_CODE:
IGNORE_PLAYBOOK_EXIT_CODE=1

# 3. Paths & Repositories:
DEFAULT_BRANCH="production"
DEFAULT_PLAYBOOK="playbooks/site.yml"
VENV_DIR="/tmp/xcat_ansible_playbook_venv"

# 4. Galaxy Configuration:
SKIP_GALAXY=0
GALAXY_FORCE=1
GALAXY_IGNORE_CERTS=${GALAXY_IGNORE_CERTS:-1}
GALAXY_HTTP_PROXY="http://httpproxy.ncsa.illinois.edu:3128"
GALAXY_HTTPS_PROXY="http://httpproxy.ncsa.illinois.edu:3128"

ANSIBLE_INSTALLED_BY_SCRIPT=0

# -----------------------------------------------------------------------------
# Sentinel & Helper Functions
# -----------------------------------------------------------------------------
if [ "$ENABLE_SENTINEL" -eq 1 ] && [ -f "$SENTINEL_FILE" ]; then
    echo "Ansible playbook has already executed on this node ($SENTINEL_FILE exists). Skipping."
    exit 0
fi

PLAYBOOK_EXECUTED=0

# Unified Cleanup Trap (Runs on exit)
cleanup() {
    local rc=$1

    if [ "$PLAYBOOK_EXECUTED" -ne 1 ]; then
        return 0
    fi

    local status="${ANSIBLE_PLAYBOOK_EXIT_CODE:-$rc}"

    if [ "$status" -ne 0 ]; then
        trace_msg "Playbook run failed (status: $status). Retaining repository, venv, and logs for debugging."
        return 0
    fi

    trace_msg "Playbook execution succeeded. Running cleanup tasks..."

    # 1. Remove vault password file
    [ -n "${PASSWORD:-}" ] && [ -f "$PASSWORD" ] && rm -f "$PASSWORD"

    # 2. Remove base Ansible repository directory (with safety checks)
    if [ -n "${BASE_ANSIBLE_DIR:-}" ] && [ -d "$BASE_ANSIBLE_DIR" ]; then
        if [ "$BASE_ANSIBLE_DIR" != "/" ] && [ "$BASE_ANSIBLE_DIR" != "/root" ]; then
            trace_msg "Removing Ansible project directory ($BASE_ANSIBLE_DIR)..."
            rm -rf "$BASE_ANSIBLE_DIR"
        fi
    fi

    # 3. Create sentinel marker file
    [ "${ENABLE_SENTINEL:-0}" -eq 1 ] && touch "$SENTINEL_FILE"

    # 4. Remove ephemeral virtual environment and cache
    if [ "${ANSIBLE_INSTALLED_BY_SCRIPT:-0}" -eq 1 ] && [ -d "$VENV_DIR" ]; then
        trace_msg "Removing temporary virtual environment ($VENV_DIR)..."
        rm -rf "$VENV_DIR"
        rm -rf /root/.ansible
    fi
}
trap 'cleanup $?' EXIT

show_help() {
    cat << 'EOF'
Usage: ansible_playbook [OPTIONS]

Options:
  -i, --inventory FILE             Path to inventory file
  -p, --project NAME               Ansible project directory name
  -b, --branch BRANCH              Git branch to check out (default: production)
  -m, --playbook FILE              Playbook path (default: playbooks/site.yml)
  -l, --limit TARGETS              Ansible limit host pattern
  -v, --vault-password-file FILE   Vault password file path
      --skip-galaxy                 Skip ansible-galaxy requirements installation
      --galaxy-disable-force        Skip forcing re-download of galaxy requirements
      --galaxy-ignore-certs         Skip SSL cert validation during galaxy installs (default)
      --galaxy-strict-certs         Enforce strict SSL cert validation for galaxy installs
  -h, --help                       Show this help message
EOF
    exit 0
}

# -----------------------------------------------------------------------------
# CLI Argument Parsing
# -----------------------------------------------------------------------------
CLI_INVENTORY="" CLI_PROJECT="" CLI_BRANCH="" CLI_PLAYBOOK="" CLI_LIMIT="" CLI_VAULT_PASS=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)               show_help ;;
        -i|--inventory)          require_arg "$1" "${2:-}"; CLI_INVENTORY="$2"; shift 2 ;;
        -p|--project)            require_arg "$1" "${2:-}"; CLI_PROJECT="$2"; shift 2 ;;
        -b|--branch)             require_arg "$1" "${2:-}"; CLI_BRANCH="$2"; shift 2 ;;
        -m|--playbook)           require_arg "$1" "${2:-}"; CLI_PLAYBOOK="$2"; shift 2 ;;
        -l|--limit)              require_arg "$1" "${2:-}"; CLI_LIMIT="$2"; shift 2 ;;
        -v|--vault-password-file) require_arg "$1" "${2:-}"; CLI_VAULT_PASS="$2"; shift 2 ;;
        --skip-galaxy)           SKIP_GALAXY=1; shift ;;
        --galaxy-skip-force)     GALAXY_FORCE=0; shift ;;
        --galaxy-ignore-certs)   GALAXY_IGNORE_CERTS=1; shift ;;
        --galaxy-strict-certs)   GALAXY_IGNORE_CERTS=0; shift ;;
        *) trace_msg "WARNING: Ignoring unknown option: $1"; shift ;;
    esac
done

HOSTNAME=$(hostname -s 2>/dev/null || echo "")
FULL_HOSTNAME=$(hostname -f 2>/dev/null || echo "")

# -----------------------------------------------------------------------------
# 1. Dependency Resolution & Ephemeral Venv
# -----------------------------------------------------------------------------
ver_to_padded() {
    local IFS=.
    local parts=($1)
    printf "%03d%03d%03d" "${parts[0]:-0}" "${parts[1]:-0}" "${parts[2]:-0}"
}

is_ansible_version_valid() {
    command -v ansible-playbook &>/dev/null || return 1

    local raw_ver
    raw_ver=$(ansible-playbook --version 2>&1 | head -n 1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n 1)
    [ -z "$raw_ver" ] && return 1

    local cur_ver_str min_ver_str max_ver_str
    cur_ver_str=$(ver_to_padded "$raw_ver")
    min_ver_str=$(ver_to_padded "$MIN_ANSIBLE_CORE_VER")
    max_ver_str=$(ver_to_padded "$MAX_ANSIBLE_CORE_VER")

    if { [[ "$cur_ver_str" > "$min_ver_str" ]] || [[ "$cur_ver_str" == "$min_ver_str" ]]; } && [[ "$cur_ver_str" < "$max_ver_str" ]]; then
        return 0
    fi

    return 1
}

ensure_dependencies() {
    export PATH="/usr/local/bin:$PATH"

    if command -v git &>/dev/null && is_ansible_version_valid; then
        trace_msg "Required dependencies (git, ansible-core >= ${MIN_ANSIBLE_CORE_VER}, < ${MAX_ANSIBLE_CORE_VER}) are present on host."
        return 0
    fi

    local pkg_mgr=""
    command -v dnf &>/dev/null && pkg_mgr="dnf" || command -v yum &>/dev/null && pkg_mgr="yum" || pkg_mgr="apt-get"

    trace_msg "Installing system prerequisites (git, python3-pip)..."
    if [ "$pkg_mgr" = "apt-get" ]; then
        apt-get update -y && apt-get install -y git python3-pip python3-dev python3-venv
    else
        $pkg_mgr install -y git python3 python3-pip python3-devel || true
    fi

    command -v git &>/dev/null || croak "Missing required OS dependency: git"

    trace_msg "Creating temporary Python virtual environment at $VENV_DIR..."
    (
        umask 077
        rm -rf "$VENV_DIR"
        python3 -m venv "$VENV_DIR"
    ) || croak "Failed to create virtual environment at $VENV_DIR"

    export PATH="$VENV_DIR/bin:$PATH"

    trace_msg "Installing Ansible packages inside virtual environment..."
    "$VENV_DIR/bin/pip" install --upgrade --no-cache-dir \
        "ansible-core>=${MIN_ANSIBLE_CORE_VER},<${MAX_ANSIBLE_CORE_VER}" \
        "ansible>=${MIN_ANSIBLE_PKG_VER},<${MAX_ANSIBLE_PKG_VER}" && ANSIBLE_INSTALLED_BY_SCRIPT=1

    command -v ansible-playbook &>/dev/null || croak "ansible-playbook binary missing in virtual environment"
}

ensure_dependencies

# -----------------------------------------------------------------------------
# 2. Configuration & Git Branch Resolution
# -----------------------------------------------------------------------------
ANSIBLE_PROJECT=$(resolve_ansible_project "$CLI_PROJECT")

ANSIBLEPATH="${BASE_ANSIBLE_DIR}/${ANSIBLE_PROJECT}"
[ ! -d "${ANSIBLEPATH}/.git" ] && croak "Git repository not found at ${ANSIBLEPATH}/.git"

PASSWORD=$(resolve_vault_path "$CLI_VAULT_PASS" "$ANSIBLE_PROJECT")
[ -f "$PASSWORD" ] && chmod 0400 "$PASSWORD"

ANSIBLE_BRANCH=$(resolve_config "$CLI_BRANCH" "ANSBRANCH" "$DEFAULT_BRANCH" "ANSIBLE_BRANCH" "ANSIBLEPROJECTBRANCH")

trace_msg "Checking out Git branch '${ANSIBLE_BRANCH}' in ${ANSIBLEPATH}..."
cd "${ANSIBLEPATH}"
git checkout -f "${ANSIBLE_BRANCH}" || git checkout -f -B "${ANSIBLE_BRANCH}" "origin/${ANSIBLE_BRANCH}" || croak "Git checkout failed."

ANSIBLE_INVENTORY=$(resolve_config "$CLI_INVENTORY" "ANSINV" "" "ANSIBLE_INVENTORY" "ANSIBLEINVENTORY" "ANSIBLEPROJECTINVENTORY")
[ -z "$ANSIBLE_INVENTORY" ] && croak "Could not determine ANSIBLE_INVENTORY."

PLAYBOOK_FILE=$(resolve_config "$CLI_PLAYBOOK" "ANSPLAYBOOK" "$DEFAULT_PLAYBOOK" "ANSIBLE_PLAYBOOK" "ANSIBLEPLAYBOOK")

DEFAULT_LIMIT="localhost,127.0.0.1"
[ -n "${NODE:-}" ]          && DEFAULT_LIMIT="${DEFAULT_LIMIT},${NODE}"
[ -n "$HOSTNAME" ]      && DEFAULT_LIMIT="${DEFAULT_LIMIT},${HOSTNAME},${HOSTNAME}.*"
[ -n "$FULL_HOSTNAME" ] && DEFAULT_LIMIT="${DEFAULT_LIMIT},${FULL_HOSTNAME}"

LIMIT_TARGETS=$(resolve_config "$CLI_LIMIT" "ANSLIMIT" "$DEFAULT_LIMIT" "ANSIBLE_LIMIT")

# -----------------------------------------------------------------------------
# 3. Ansible Galaxy Requirements Resolution
# -----------------------------------------------------------------------------
install_galaxy_requirements() {
    [ "$SKIP_GALAXY" -eq 1 ] && return 0
    command -v ansible-galaxy &>/dev/null || return 0

    local req_files=(
        "${ANSIBLEPATH}/requirements.yml"
        "${ANSIBLEPATH}/requirements.yaml"
        "${ANSIBLEPATH}/collections/requirements.yml"
        "${ANSIBLEPATH}/roles/requirements.yml"
    )

    for req_file in "${req_files[@]}"; do
        if [ -f "$req_file" ]; then
            trace_msg "Installing Ansible Galaxy requirements from ${req_file}..."
            
            if [ -n "$GALAXY_HTTP_PROXY" ]; then
                export http_proxy="$GALAXY_HTTP_PROXY" HTTP_PROXY="$GALAXY_HTTP_PROXY"
                export https_proxy="${GALAXY_HTTPS_PROXY:-$GALAXY_HTTP_PROXY}" HTTPS_PROXY="${GALAXY_HTTPS_PROXY:-$GALAXY_HTTP_PROXY}"
            fi

            local galaxy_opts=()
            [ "$GALAXY_FORCE" -eq 1 ] && galaxy_opts+=("--force")

            if [ "$GALAXY_IGNORE_CERTS" -eq 1 ]; then
                galaxy_opts+=("--ignore-certs")
                export ANSIBLE_GALAXY_SERVER_GALAXY_IGNORE_CERTS=True
            fi

            if ! ansible-galaxy install -r "$req_file" "${galaxy_opts[@]}"; then
                croak "Failed to install Galaxy requirements from $req_file"
            fi

            unset http_proxy HTTP_PROXY https_proxy HTTPS_PROXY ANSIBLE_GALAXY_SERVER_GALAXY_IGNORE_CERTS
        fi
    done
}

install_galaxy_requirements

# -----------------------------------------------------------------------------
# 4. Execution & Logging
# -----------------------------------------------------------------------------
[ -d "${ANSIBLEPATH}/collections" ] && export ANSIBLE_COLLECTIONS_PATH="${ANSIBLEPATH}/collections:${HOME}/.ansible/collections"
[ -d "${ANSIBLEPATH}/roles" ]       && export ANSIBLE_ROLES_PATH="${ANSIBLEPATH}/roles:${HOME}/.ansible/roles"

if [ -n "$PASSWORD" ] && [ ! -f "$PASSWORD" ]; then
    croak "Configured vault password file does not exist: $PASSWORD"
fi

[ -e "$ANSIBLE_INVENTORY" ] ||
    croak "Inventory does not exist: $ANSIBLE_INVENTORY"
[ -f "$PLAYBOOK_FILE" ] ||
    croak "Playbook does not exist: $PLAYBOOK_FILE"

ANSIBLE_COMMAND=(
    ansible-playbook
    -i "$ANSIBLE_INVENTORY"
    "$PLAYBOOK_FILE"
    --connection=local
    --limit "$LIMIT_TARGETS"
)
if [ -f "$PASSWORD" ]; then
    ANSIBLE_COMMAND+=("--vault-password-file" "$PASSWORD")
fi

XCAT_LOG_DIR="${XCATLOGDIR:-$(dirname "${XCATLOGFILE:-/var/log/xcat/xcat.log}")}"
mkdir -p "$XCAT_LOG_DIR"
LOG_FILE="${XCAT_LOG_DIR}/ansible_playbook.log"

logr "Ansible playbook execution starting. Output will be logged to: $LOG_FILE"
trace_msg "Executing: $(printf '%q ' "${ANSIBLE_COMMAND[@]}")"

PLAYBOOK_EXECUTED=1
set +e
"${ANSIBLE_COMMAND[@]}" > "$LOG_FILE" 2>&1
ANSIBLE_PLAYBOOK_EXIT_CODE=$?
set -e

if [ "$ANSIBLE_PLAYBOOK_EXIT_CODE" -eq 0 ]; then
    logr "Ansible playbook execution completed successfully. Log: $LOG_FILE"
else
    logr "ERROR: Ansible playbook failed with exit code $ANSIBLE_PLAYBOOK_EXIT_CODE."
    logr "--- Playbook Failure Summary ---"
    if [ -f "$LOG_FILE" ]; then
        recap_output=$(sed -n '/PLAY RECAP/,$p' "$LOG_FILE" | grep -v '^[[:space:]]*$')
        if [ -z "$recap_output" ]; then
            recap_output=$(tail -n 10 "$LOG_FILE" | grep -v '^[[:space:]]*$')
        fi
        if [ -n "$recap_output" ]; then
            echo "$recap_output" | while IFS= read -r line; do
                logr "  $line"
            done
        fi
    fi
    logr "--- End of error summary ---"
fi

if [ "$IGNORE_PLAYBOOK_EXIT_CODE" -eq 1 ]; then
    exit "$ANSIBLE_PLAYBOOK_EXIT_CODE"
else
    exit 0
fi
